# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- LLM (Ollama) ---
# Sem OLLAMA_API_KEY e sem OLLAMA_BASE_URL, o sistema entra em MODO DEMO (LLM simulado) e tudo continua funcionando.
# Ollama Cloud: preencha só OLLAMA_API_KEY (chave em https://ollama.com/settings/keys).
# Ollama local: OLLAMA_BASE_URL=http://localhost:11434 e `ollama pull gpt-oss:120b` (requer ~65 GB de memória).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_THINK=medium          # raciocínio do gpt-oss: low | medium | high
LLM_PROVIDER=auto            # auto | ollama | mock

# --- Limites ---
DAILY_LIMIT=50

# --- Capacidades (desligue o que não for usar) ---
ENABLE_BROWSER=1             # Selenium
BROWSER_HEADLESS=1
BROWSER_NO_SANDBOX=0         # use 1 apenas dentro de Docker
ENABLE_DESKTOP=0             # BotCity (controla o mouse/teclado REAIS do computador)

# --- Infra opcional ---
REDIS_URL=
EMBEDDING_BACKEND=hash       # hash (offline, leve) | st (sentence-transformers)
