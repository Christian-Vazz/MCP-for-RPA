# =====================================================================
# Orbit Agent — configuração (lida por config/settings.py)
# Valores vazios usam o padrão indicado no comentário.
# =====================================================================

# --- Django ---
# Chave secreta: gere uma nova para cada ambiente e nunca a publique.
DJANGO_SECRET_KEY=troque-esta-chave
# 1 = modo desenvolvimento (mostra erros). Use 0 em produção.
DJANGO_DEBUG=1
# Hosts aceitos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- LLM (Ollama) ---
# auto = Ollama se houver OLLAMA_API_KEY ou OLLAMA_BASE_URL, senão modo demonstração | ollama | mock
LLM_PROVIDER=auto
# Ollama Cloud: preencha só a chave (https://ollama.com/settings/keys).
OLLAMA_API_KEY=
# Ollama local: http://localhost:11434 (vazio = Ollama Cloud se houver chave).
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:120b
# Raciocínio do gpt-oss: low | medium | high (vazio = padrão do modelo).
OLLAMA_THINK=medium
# Contexto em tokens (o padrão do Ollama local é curto demais para prompt + ferramentas).
OLLAMA_NUM_CTX=32768
# Máximo de tokens gerados por chamada (inclui o raciocínio do gpt-oss).
MAX_OUTPUT_TOKENS=4096
# Segundos sem receber nada do stream antes de desistir.
LLM_TIMEOUT=180

# --- Limites ---
# Solicitações por usuário por dia.
DAILY_LIMIT=50

# --- Rede (web_fetch, memória por link, navegador) ---
# Vazio = qualquer domínio público. Separe por vírgula, ex.: gov.br,wikipedia.org
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=

# --- Navegador (Selenium) e desktop (BotCity) ---
ENABLE_BROWSER=1
# 0 = mostra a janela do Chrome (útil para acompanhar a automação).
BROWSER_HEADLESS=1
# Use 1 apenas dentro de Docker.
BROWSER_NO_SANDBOX=0
# 1 = controla o mouse/teclado REAIS do computador. Só para demonstração local.
ENABLE_DESKTOP=0

# --- RAG / busca vetorial ---
# Com PINECONE_API_KEY (https://app.pinecone.io), "auto" usa o Pinecone para os vetores E para os
# embeddings (multilingual-e5-large, semântico). Sem chave: busca local (numpy) + embeddings por hashing.
PINECONE_API_KEY=
# Criado sozinho (serverless, cosseno) se não existir.
PINECONE_INDEX=orbit-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Prefixo dos namespaces (ex.: dev-) para dividir um índice entre ambientes.
PINECONE_NAMESPACE_PREFIX=
PINECONE_EMBED_MODEL=multilingual-e5-large
# auto | local | pinecone
VECTOR_STORE=auto
# auto | hash (offline) | st (sentence-transformers) | pinecone
EMBEDDING_BACKEND=auto
# Modelo usado só com EMBEDDING_BACKEND=st.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Trocou o motor de embeddings ou de vetores? Rode: python manage.py reindex_knowledge

# --- Infra opcional ---
# Cache compartilhado entre processos, ex.: redis://localhost:6379/0 (vazio = cache em memória).
REDIS_URL=
